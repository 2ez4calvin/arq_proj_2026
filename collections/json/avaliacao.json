                ]
              }
            }
          ]
        },
        {
          "name": "Listener: 2 avaliacoes PENDENTE, uma em cada direcao",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/avaliacoes/proposta/{{propostaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "avaliacoes",
                "proposta",
                "{{propostaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test('existem exatamente 2 avaliacoes', () => pm.expect(lista.length).to.eql(2));",
                  "pm.test('todas PENDENTE e sem nota', () => lista.forEach(a => { pm.expect(a.status).to.eql('PENDENTE'); pm.expect(a.nota == null).to.be.true; }));",
                  "const dono = Number(pm.collectionVariables.get('donoId')), autor = Number(pm.collectionVariables.get('autorId'));",
                  "const doDono = lista.find(a => a.usuarioAutorId === dono), doAutor = lista.find(a => a.usuarioAutorId === autor);",
                  "pm.test('uma avaliacao em cada direcao', () => { pm.expect(doDono, 'avaliacao do dono').to.exist; pm.expect(doAutor, 'avaliacao do autor').to.exist; pm.expect(doDono.usuarioAlvoId).to.eql(autor); pm.expect(doAutor.usuarioAlvoId).to.eql(dono); });",
                  "if (doDono) pm.collectionVariables.set('avalDonoId', doDono.id);",
                  "if (doAutor) pm.collectionVariables.set('avalAutorId', doAutor.id);"
                ]
              }
            }
          ]
        }
      ]
    },
