                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/propostas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "propostas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bicicleta\",\n  \"descricao\": \"Troco por violao\",\n  \"tipo\": \"troca\",\n  \"usuarioId\": {{donoId}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('status = RASCUNHO', () => pm.expect(pm.response.json().status).to.eql('RASCUNHO'));",
