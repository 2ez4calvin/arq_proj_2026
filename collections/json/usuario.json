            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('encontrou ao menos 2', () => pm.expect(pm.response.json().length).to.be.at.least(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Atualizar",
