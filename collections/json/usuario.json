{
  "info": {
    "name": "Trokr - Usuarios",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode a collection inteira, na ordem. Cria dois usuarios com e-mails unicos e remove ao final."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    }
  ],
  "item": [
    {
      "name": "1. Criar e validar",
      "item": [
        {
          "name": "Criar usuario dono",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Dono Teste\",\n  \"email\": \"{{emailDono}}\",\n  \"cidade\": \"Formosa\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailDono', 'dono' + Date.now() + '@teste.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('retorna id', () => pm.expect(pm.response.json().id).to.be.a('number'));",
                  "pm.test('email correto', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('emailDono')));",
                  "pm.collectionVariables.set('donoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar usuario autor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
