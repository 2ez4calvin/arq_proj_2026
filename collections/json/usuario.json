              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Autor Teste\",\n  \"email\": \"{{emailAutor}}\",\n  \"cidade\": \"Brasilia\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailAutor', 'autor' + Date.now() + '@teste.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('email correto', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('emailAutor')));",
                  "pm.collectionVariables.set('autorId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
